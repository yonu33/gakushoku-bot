/**
 * Wrangler の設定: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * シークレットはここに書かず `npx wrangler secret put <名前>` で登録する（README 参照）:
 *   DISCORD_WEBHOOK_URL  投稿先
 *   TEST_SECRET_KEY      動作確認エンドポイントのキー（未設定ならエンドポイントは 404）
 *   ALERT_WEBHOOK_URL    任意。取得エラーの通知先
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gakushoku-bot",
	"main": "src/index.js",
	"compatibility_date": "2025-11-01",
	"observability": {
		"enabled": true
	},
	// 時刻は UTC。追加・変更したら src/jobs.js の CRON_JOBS にも登録すること（テストで確認している）
	// 緊急停止するときは crons を [] にしてデプロイする（README「停止方法」）
	"triggers": {
		"crons": [
			"0 1 * * *", // 10:00 JST 当日の日替わりランチ
			"30 6 * * *", // 15:30 JST 当日の夕食セット
			"0 10 * * *" // 19:00 JST 翌日のメニュー予告
		]
	}
}
